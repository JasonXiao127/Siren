{
  "name": "siren",
  "version": "1.0.0",
  "private": true,
  "description": "Siren — Jellyfin music client for the desktop",
  "author": {
    "name": "Marauder"
  },
  "main": "dist-electron/main.cjs",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace=@siren/client && npm run build:electron",
    "build:electron": "tsc -p electron/tsconfig.json && node scripts/build-electron.mjs",
    "icons": "electron scripts/gen-icon.cjs",
    "typecheck": "tsc -p electron/tsconfig.json && tsc -p server/tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit",
    "start": "electron .",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run dist -- --win",
    "dist:mac": "npm run dist -- --mac",
    "dist:linux": "npm run dist -- --linux"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2"
  },
  "allowScripts": {
    "electron@43.4.1": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
